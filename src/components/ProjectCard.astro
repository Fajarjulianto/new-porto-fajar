---
interface Props {
  image: string; name: string; description: string; technology?: string;
  technologies?: string[]; repository?: string; demo?: string; width: number; height: number;
}
const { image, name, description, technology, technologies = [technology, 'Tailwind CSS'].filter(Boolean), repository, demo, width, height } = Astro.props;
---
<article class="relative mt-5 mb-5 flex min-w-0 w-full flex-col overflow-hidden rounded-lg border border-[#ccc] shadow-[0_0_10px_rgba(0,0,0,0.1)] transition-transform duration-300 motion-safe:hover:-translate-y-2">
  <div class="[&_img]:block [&_img]:h-75 [&_img]:w-full [&_img]:object-cover max-[600px]:[&_img]:h-auto max-[600px]:[&_img]:aspect-[1.55]"><img src={`/assets/${image}`} alt={`${name} website preview`} width={width} height={height} loading="lazy" decoding="async" /></div>
  <div class="flex w-full flex-1 flex-col px-5 pt-5">
    <div class="mt-2.5 flex w-full flex-col items-start text-left [&_h3]:text-[18px] [&_h3]:font-bold [&_h3]:uppercase [&_h3]:text-brand [&_p]:mb-2.5 [&_p]:text-[17px] [&_p]:font-bold"><h3>{name}</h3><p>{description}</p></div>
    <div class="flex flex-wrap gap-x-5 gap-y-1.25 font-mulish text-[17px] font-bold text-ink">{technologies.map((item) => <p class="mb-2.5 rounded-[5px]">{item}</p>)}</div>
    <div class="mt-auto flex items-center pt-2.5 [&_a]:mr-2.5 [&_a]:mb-2.5 [&_a]:inline-block [&_a]:rounded-[5px] [&_a]:border [&_a]:border-[#ccc] [&_a]:px-2.5 [&_a]:py-1.25 [&_a]:text-base [&_a]:font-bold [&_a]:text-[#333] [&_a:hover]:bg-[#f0f0f0] [&_a:hover]:text-brand">
      {repository && <a href={repository} target="_blank" rel="noopener noreferrer" aria-label={`View ${name} source code on GitHub`}>Code</a>}
      {demo && <a href={demo} target="_blank" rel="noopener noreferrer" aria-label={`View ${name} live demo`}>View</a>}
    </div>
  </div>
</article>
